/* ============================================================
 * Windows 安全系统 2.0 - 全局样式表(QSS)
 * 完全复刻 UI 最终效果图: 深色科技风
 *   背景 #0B1120 / 面板 #151E32 / 卡片 #161E2E
 *   主色蓝 #3B82F6 / 成功绿 #10B981 / 文字白 #FFFFFF / 次要 #9CA3AF
 * 控件通过 objectName 对应样式, 修改样式只需改本文件
 * ============================================================ */

/* ── 全局 ── */
QMainWindow, QWidget#appRoot, QWidget#appBody {
    background-color: #0B1120;
}

/* ── 顶部标题栏 ── */
QFrame#titleBar {
    background-color: #0F1728;
    border-bottom: 1px solid #1E293B;
}
QLabel#appIcon {
    color: #3B82F6;
    font-size: 18px;
}
QLabel#appTitle {
    color: #FFFFFF;
    font-size: 15px;
    font-weight: bold;
}
QPushButton#winBtn {
    background: transparent;
    color: #9CA3AF;
    border: none;
    font-size: 13px;
    min-width: 36px;
    max-width: 36px;
    min-height: 30px;
    max-height: 30px;
    border-radius: 4px;
}
QPushButton#winBtn:hover {
    background-color: #1E293B;
    color: #FFFFFF;
}
QPushButton#winBtnClose {
    background: transparent;
    color: #9CA3AF;
    border: none;
    font-size: 13px;
    min-width: 36px;
    max-width: 36px;
    min-height: 30px;
    max-height: 30px;
    border-radius: 4px;
}
QPushButton#winBtnClose:hover {
    background-color: #E11D48;
    color: #FFFFFF;
}

/* ── 左侧导航栏 ── */
QListWidget#navList {
    background-color: #0F1728;
    border: none;
    color: #9CA3AF;
    font-size: 14px;
    outline: 0;
    padding-top: 10px;
}
QListWidget#navList::item {
    height: 46px;
    padding-left: 20px;
    border-left: 3px solid transparent;
}
QListWidget#navList::item:hover {
    background-color: #16213A;
    color: #D1D5DB;
}
QListWidget#navList::item:selected {
    background-color: #1E293B;
    color: #FFFFFF;
    border-left: 3px solid #3B82F6;
}

/* ── 页面通用 ── */
QLabel#pageTitle {
    color: #FFFFFF;
    font-size: 22px;
    font-weight: bold;
}
QLabel#pageSubtitle {
    color: #9CA3AF;
    font-size: 13px;
}
QLabel#cardTitle {
    color: #FFFFFF;
    font-size: 16px;
    font-weight: bold;
}
QLabel#cardText {
    color: #9CA3AF;
    font-size: 13px;
}
QLabel#cardValue {
    color: #FFFFFF;
    font-size: 15px;
    font-weight: bold;
}

/* ── 通用卡片 ── */
QFrame#card {
    background-color: #151E32;
    border-radius: 12px;
}

/* ── 安全概览: 评分卡 ── */
QFrame#scoreCard {
    background-color: #151E32;
    border-radius: 12px;
}
QLabel#scoreValue {
    color: #3B82F6;
    font-size: 52px;
    font-weight: bold;
}
QLabel#scoreLabel {
    color: #9CA3AF;
    font-size: 14px;
}
QLabel#scoreIcon {
    color: #3B82F6;
    font-size: 56px;
}

/* ── 安全概览: 功能状态网格卡片 ── */
QFrame#gridCard {
    background-color: #151E32;
    border-radius: 10px;
}
QLabel#gridIcon {
    font-size: 26px;
}
QLabel#gridTitle {
    color: #D1D5DB;
    font-size: 13px;
}
QLabel#gridStatus {
    color: #10B981;
    font-size: 12px;
    font-weight: bold;
}
QLabel#dotOn {
    background-color: #10B981;
    border-radius: 4px;
    min-width: 8px;
    max-width: 8px;
    min-height: 8px;
    max-height: 8px;
}

/* ── 安全概览: 底部统计条 ── */
QFrame#statBar {
    background-color: #0F1728;
    border: 1px solid #1E293B;
    border-radius: 10px;
}
QLabel#statIcon {
    font-size: 20px;
}
QLabel#statValue {
    color: #FFFFFF;
    font-size: 16px;
    font-weight: bold;
}
QLabel#statLabel {
    color: #9CA3AF;
    font-size: 12px;
}

/* ── 用户头像(圆形) ── */
QFrame#userAvatar {
    background-color: #1E293B;
    border: 2px solid #2D3A52;
    border-radius: 20px;
}
QFrame#userAvatar:hover {
    border: 2px solid #3B82F6;
}
QLabel#userAvatarIcon {
    color: #9CA3AF;
    font-size: 22px;
}
QLabel#bigAvatar {
    background-color: #1E293B;
    border: 2px solid #3B82F6;
    border-radius: 48px;
    color: #D1D5DB;
    font-size: 48px;
}

/* ── 全屏摄像头画面页(深色基调, 预留整屏变色) ── */
QWidget#livePage {
    background-color: #000000;
}
QLabel#videoLabel {
    background-color: #000000;
    border: none;
}
QLabel#livePrompt {
    color: #FFFFFF;
    font-size: 26px;
    font-weight: bold;
    padding: 20px;
    background-color: #0B1120;
}
QPushButton#liveExitBtn {
    background-color: rgba(59, 130, 246, 0.85);
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    font-size: 14px;
    padding: 8px 18px;
}
QPushButton#liveExitBtn:hover {
    background-color: #3B82F6;
}

/* 录入成功覆盖层(整屏变色 + 白色对勾/文字) */
QLabel#successCheck {
    color: #FFFFFF;
    font-size: 96px;
    font-weight: bold;
    background: transparent;
}
QLabel#successText {
    color: #FFFFFF;
    font-size: 28px;
    font-weight: bold;
    background: transparent;
}

/* ── 返回按钮 ── */
QPushButton#backBtn {
    background: transparent;
    color: #9CA3AF;
    border: none;
    font-size: 13px;
    padding: 4px 10px;
    border-radius: 4px;
}
QPushButton#backBtn:hover {
    background-color: #1E293B;
    color: #FFFFFF;
}

/* ── 页内标签栏(识别/录入切换) ── */
QTabBar#pageTab {
    background: transparent;
}
QTabBar#pageTab::tab {
    background: transparent;
    color: #9CA3AF;
    font-size: 14px;
    padding: 6px 18px;
    border-bottom: 2px solid transparent;
}
QTabBar#pageTab::tab:hover {
    color: #D1D5DB;
}
QTabBar#pageTab::tab:selected {
    color: #FFFFFF;
    border-bottom: 2px solid #3B82F6;
}

/* ── 识别页: 画面区 ── */
QFrame#previewArea {
    background-color: #0D1424;
    border: 1px solid #1E2A44;
    border-radius: 10px;
}
QFrame#cornerTL { border-top: 3px solid #3B82F6; border-left: 3px solid #3B82F6; }
QFrame#cornerTR { border-top: 3px solid #3B82F6; border-right: 3px solid #3B82F6; }
QFrame#cornerBL { border-bottom: 3px solid #3B82F6; border-left: 3px solid #3B82F6; }
QFrame#cornerBR { border-bottom: 3px solid #3B82F6; border-right: 3px solid #3B82F6; }
QLabel#previewPlaceholder {
    color: #4B5A76;
    font-size: 16px;
}
QLabel#previewStatus {
    color: #10B981;
    font-size: 14px;
    font-weight: bold;
}

/* ── 识别页: 设置卡片 ── */
QFrame#settingsCard {
    background-color: #161E2E;
    border-radius: 10px;
}
QLabel#settingsTitle {
    color: #FFFFFF;
    font-size: 16px;
    font-weight: bold;
}
QLabel#settingLabel {
    color: #D1D5DB;
    font-size: 14px;
}
QLabel#settingValue {
    color: #9CA3AF;
    font-size: 14px;
}

/* ── 蓝屏识别: 检测结果区 ── */
QPlainTextEdit#bsodResultText {
    background-color: #0D1424;
    color: #D1D5DB;
    border: 1px solid #1E2A44;
    border-radius: 8px;
    font-family: "Microsoft YaHei";
    font-size: 13px;
    padding: 10px;
}

/* ── 密码管理: 环形图卡片 ── */
QFrame#gaugeCard {
    background-color: #151E32;
    border-radius: 12px;
}
QLabel#gaugeValue {
    color: #10B981;
    font-size: 26px;
    font-weight: bold;
}
QLabel#gaugeSub {
    color: #9CA3AF;
    font-size: 13px;
}
QFrame#checkCard {
    background-color: #151E32;
    border-radius: 12px;
}
QFrame#checkItem {
    background-color: #1F2937;
    border-radius: 6px;
}
QLabel#checkMark {
    color: #10B981;
    font-size: 14px;
    font-weight: bold;
}
QLabel#checkText {
    color: #D1D5DB;
    font-size: 13px;
}

/* ── 蓝屏识别: 模拟蓝屏 ── */
QFrame#bsodSim {
    background-color: #0F6BDE;
    border-radius: 12px;
}
QLabel#bsodFace {
    color: #FFFFFF;
    font-size: 64px;
}
QLabel#bsodTitle {
    color: #FFFFFF;
    font-size: 16px;
    font-weight: bold;
}
QLabel#bsodText {
    color: #DCE9FB;
    font-size: 13px;
}
QLabel#bsodProgress {
    color: #FFFFFF;
    font-size: 13px;
}

/* ── 输入框 ── */
QLineEdit#enrollInput, QLineEdit#passwordInput {
    background-color: #1F2937;
    color: #D1D5DB;
    border: 1px solid #2D3A52;
    border-radius: 6px;
    padding: 8px 10px;
    font-size: 13px;
}
QLineEdit#enrollInput:focus, QLineEdit#passwordInput:focus {
    border: 1px solid #3B82F6;
}

/* ── 去水印页: 路径输入框 ── */
QLineEdit#pathEdit {
    background-color: #1F2937;
    color: #D1D5DB;
    border: 1px solid #2D3A52;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}
QLineEdit#pathEdit:focus { border: 1px solid #3B82F6; }
QLineEdit#pathEdit:disabled { color: #6B7280; }

/* ── 去水印页: 选项说明(适用情景/速度提示) ── */
QLabel#hintLabel {
    color: #6B7280;
    font-size: 11px;
    padding-left: 2px;
}

/* ── 去水印页: 进度条 ── */
QProgressBar#watermarkProgress {
    background-color: #1F2937;
    border: 1px solid #2D3A52;
    border-radius: 6px;
    height: 14px;
    text-align: center;
    color: #D1D5DB;
    font-size: 11px;
}
QProgressBar#watermarkProgress::chunk {
    background-color: #3B82F6;
    border-radius: 5px;
}

/* ── 下拉框 ── */
QComboBox {
    background-color: #1F2937;
    color: #9CA3AF;
    border: 1px solid #2D3A52;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 13px;
    min-width: 130px;
}
QComboBox::drop-down { border: none; width: 24px; }
QComboBox QAbstractItemView {
    background-color: #1F2937;
    color: #D1D5DB;
    selection-background-color: #3B82F6;
    border: 1px solid #2D3A52;
}

/* ── 按钮 ── */
QPushButton#primaryBtn {
    background-color: #2B4C7E;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    font-size: 14px;
    padding: 10px 16px;
}
QPushButton#primaryBtn:hover { background-color: #35619F; }
QPushButton#primaryBtn:pressed { background-color: #223D66; }
QPushButton#primaryBtn:disabled { background-color: #2A3446; color: #6B7280; }

QPushButton#blueBtn {
    background-color: #3B82F6;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    font-size: 14px;
    padding: 10px 24px;
}
QPushButton#blueBtn:hover { background-color: #4F8FF7; }
QPushButton#blueBtn:pressed { background-color: #2F6FD6; }

/* ── 占位页 ── */
QLabel#placeholderTitle {
    color: #FFFFFF;
    font-size: 22px;
    font-weight: bold;
}
QLabel#placeholderText {
    color: #9CA3AF;
    font-size: 14px;
}
